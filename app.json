{
  "expo": {
    "name": "Getnet Healthcare",
    "slug": "getnet-healthcare",
    "scheme": "getnet",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icons/icons.jpg",
        "backgroundColor": "#0F8B8D"
      },
      "package": "com.Fewosclinic.healthcare"
    },
    "icon": "./src/assets/icons/icons.jpg",
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "faa77d83-3e5c-4a56-b8c2-4b021af9baa3"
      }
    },
    "owner": "mebrieawoke"
  }
}
